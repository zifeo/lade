amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

steps {
    ["newlines"] = (Builtins.newlines) {
        // mise.toml is generated by mise-action in CI, never committed.
        exclude = List("typegate/deno.lock", "examples/tape/*.txt", "mise.toml")
    }
    ["fmt"] = Builtins.cargo_fmt
    ["check"] = (Builtins.cargo_check) {
        check = "cargo check --locked --quiet"
    }
    ["clippy"] = (Builtins.cargo_clippy) {
        check = "cargo clippy --all-targets --locked --quiet -- -D warnings"
    }
}
